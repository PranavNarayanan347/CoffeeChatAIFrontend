# Redis Configuration for Rate Limiting
# Copy this file to .env and fill in your actual Redis credentials

# Redis Connection (for distributed rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis URL format (alternative to above)
# REDIS_URL=redis://:password@host:port/db

# For production with Redis Cloud, Heroku Redis, etc:
# REDIS_URL=redis://:password@redis-12345.c1.us-east-1-1.ec2.cloud.redislabs.com:12345

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=redis  # Options: memory, redis

# Default Rate Limits (requests per window)
RATE_LIMIT_FORGOT_PASSWORD=3  # per hour per email
RATE_LIMIT_RESET_PASSWORD=5   # per hour per IP
RATE_LIMIT_LOGIN=10            # per hour per IP
RATE_LIMIT_GENERAL=100         # per hour per IP



